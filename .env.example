# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key from Settings → API. The anon key is safe in the
# browser; row-level security is what protects the data.
VITE_SUPABASE_URL=UPDATE HERE
VITE_SUPABASE_ANON_KEY=UPDATE HERE

# Service-role key. Bypasses row-level security entirely — it belongs only in
# edge functions and server-side code, never in anything bundled for the browser.
SUPABASE_SERVICE_ROLE_KEY=UPDATE HERE

# ── Model providers ───────────────────────────────────────────────────────────
# Used by the chat and report-generation edge functions.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=UPDATE HERE
# https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=UPDATE HERE

# ── Zoho payments ─────────────────────────────────────────────────────────────
# OAuth client from the Zoho API console, plus a long-lived refresh token.
ZOHO_CLIENT_ID=UPDATE HERE
ZOHO_CLIENT_SECRET=UPDATE HERE
ZOHO_REFRESH_TOKEN=UPDATE HERE
ZOHO_ACCOUNT_ID=UPDATE HERE
VITE_ZOHO_ACCOUNT_ID=UPDATE HERE
VITE_ZOHO_API_KEY=UPDATE HERE
# (default: https://www.zohoapis.in)
ZOHO_API_BASE=UPDATE HERE
# Shared secret used to verify inbound payment webhooks. Without it, anyone who
# finds the endpoint can forge a payment-success callback.
ZOHO_WEBHOOK_SECRET=UPDATE HERE

# ── App ───────────────────────────────────────────────────────────────────────
# Public origin, used for payment redirects and CORS.
# (default: http://localhost:8080)
FRONTEND_URL=UPDATE HERE

# Microsoft Clarity project id for session analytics. Leave unset to disable.
VITE_CLARITY_PROJECT_ID=UPDATE HERE
